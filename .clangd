CompileFlags:
  Add: [
    # -std=c++20,
    # -Wall,
    # -Wextra,
]

Diagnostics:
  ClangTidy:
    Add: [
      modernize-*,
      performance-*,
      bugprone-*,

      clang-analyzer-*,
      portability-*,
      misc-unused-parameters,

      cppcoreguidelines-*
    ]
    Remove: [
      readability-identifier-length,
      readability-magic-numbers,
      cppcoreguidelines-avoid-magic-numbers,
      cppcoreguidelines-pro-type-vararg
    ]

Index:
  Background: Build